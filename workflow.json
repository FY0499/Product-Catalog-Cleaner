      "parameters": {
        "jsCode": "return items.filter(item => {\n  const p = item.json;\n  const missingFields = !p.category || !p.description || !p.price;\n  const nameHasIssues = p.productName && (p.productName !== p.productName.trim() || /\\s{2,}/.test(p.productName));\n  return missingFields || nameHasIssues;\n});"
      },
