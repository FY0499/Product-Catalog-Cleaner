      "id": "41d1e8b5-2ade-4c7e-b23e-b90176525144",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "const aiItems = $input.all();\nconst products = $('Code in JavaScript').all();\n\nreturn aiItems.map((item, index) => {\n  const raw = item.json.output ?? item.json.text ?? '';\n\n  const cleaned = String(raw)\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  const parsed = JSON.parse(cleaned);\n\n  return {\n    json: {\n      ...parsed,\n      sku: products[index].json.sku\n    }\n  };\n});"
      },
